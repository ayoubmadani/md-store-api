{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron/shipping-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/internal/cron/custom-themes",
      "schedule": "0 4 * * *"
    }
  ]
}
